{
  "redirects": [
    {
      "source": "/JOJO",
      "destination": "/JOJO/",
      "permanent": false
    },
    {
      "source": "/jojopractice",
      "destination": "/jojopractice/",
      "permanent": false
    },
    {
      "source": "/Brilliant",
      "destination": "/Brilliant/",
      "permanent": false
    },
    {
      "source": "/eyestra",
      "destination": "/eyestra/",
      "permanent": false
    },
    {
      "source": "/qh5day",
      "destination": "/qh5day/",
      "permanent": false
    },
    {
      "source": "/compreesor",
      "destination": "/compreesor/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/compreesor/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/compreesor/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/calendar",
      "destination": "/api/calendar"
    },
    {
      "source": "/api/schedule",
      "destination": "/api/schedule"
    },
    {
      "source": "/JOJO/",
      "destination": "/JOJO/index.html"
    },
    {
      "source": "/jojopractice/",
      "destination": "/jojopractice/index.html"
    },
    {
      "source": "/Brilliant/",
      "destination": "/Brilliant/index.html"
    },
    {
      "source": "/eyestra/",
      "destination": "/eyestra/index.html"
    },
    {
      "source": "/qh5day/",
      "destination": "/qh5day/index.html"
    },
    {
      "source": "/compreesor/",
      "destination": "/compreesor/index.html"
    },
    {
      "source": "/((?!JOJO/|jojopractice/|Brilliant/|eyestra/|qh5day/|compreesor/).*)",
      "destination": "/index.html"
    }
  ]
}
