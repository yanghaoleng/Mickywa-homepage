{
  "redirects": [
    {
      "source": "/JOJO",
      "destination": "/JOJO/",
      "permanent": false
    },
    {
      "source": "/jojopractice",
      "destination": "/jojopractice/",
      "permanent": false
    },
    {
      "source": "/Brilliant",
      "destination": "/Brilliant/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/calendar",
      "destination": "/api/calendar"
    },
    {
      "source": "/api/schedule",
      "destination": "/api/schedule"
    },
    {
      "source": "/JOJO/",
      "destination": "/JOJO/index.html"
    },
    {
      "source": "/jojopractice/",
      "destination": "/jojopractice/index.html"
    },
    {
      "source": "/Brilliant/",
      "destination": "/Brilliant/index.html"
    },
    {
      "source": "/((?!JOJO/|jojopractice/|Brilliant/).*)",
      "destination": "/index.html"
    }
  ]
}
